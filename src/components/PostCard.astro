---
interface Props {
  title: string;
  date: Date;
  description: string;
  slug: string;
}

const { title, date, description, slug } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<a href={`${import.meta.env.BASE_URL}posts/${slug}`} class="post-card">
  <div class="post-card-date">{formattedDate}</div>
  <h2 class="post-card-title">{title}</h2>
  <p class="post-card-desc">{description}</p>
  <div class="post-card-read">Read →</div>
</a>
