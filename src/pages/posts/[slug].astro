---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import IeltsSpeakingBody from '../../components/posts/IeltsSpeakingBody.astro';
import IeltsWritingTaskTypesBody from '../../components/posts/IeltsWritingTaskTypesBody.astro';
import IeltsWritingOpinionAnalysisBody from '../../components/posts/IeltsWritingOpinionAnalysisBody.astro';
import IeltsWritingDiscussionAnalysisBody from '../../components/posts/IeltsWritingDiscussionAnalysisBody.astro';
import IeltsWritingAdvDisadvAnalysisBody from '../../components/posts/IeltsWritingAdvDisadvAnalysisBody.astro';
import IeltsWritingProblemSolutionAnalysisBody from '../../components/posts/IeltsWritingProblemSolutionAnalysisBody.astro';
import IeltsWritingTwoPartAnalysisBody from '../../components/posts/IeltsWritingTwoPartAnalysisBody.astro';
import IeltsCollocationsBody from '../../components/posts/IeltsCollocationsBody.astro';
import IeltsTask1LineGraphBody from '../../components/posts/IeltsTask1LineGraphBody.astro';
import IeltsTask1BarChartBody from '../../components/posts/IeltsTask1BarChartBody.astro';
import IeltsTask1PieChartBody from '../../components/posts/IeltsTask1PieChartBody.astro';
import IeltsTask1TableBody from '../../components/posts/IeltsTask1TableBody.astro';
import IeltsTask1MixedChartBody from '../../components/posts/IeltsTask1MixedChartBody.astro';
import IeltsTask1ProcessBody from '../../components/posts/IeltsTask1ProcessBody.astro';
import IeltsTask1MapBody from '../../components/posts/IeltsTask1MapBody.astro';
import IeltsWritingTask2HowToBody from '../../components/posts/IeltsWritingTask2HowToBody.astro';
import IeltsWritingTask2StructureGuideBody from '../../components/posts/IeltsWritingTask2StructureGuideBody.astro';
import SameQuestionTwoWorldsBody from '../../components/posts/SameQuestionTwoWorldsBody.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <nav class="post-nav">
    <a href={import.meta.env.BASE_URL} class="post-nav-back">← All Posts</a>
  </nav>
  {post.slug === 'ielts-speaking'
    ? <IeltsSpeakingBody />
    : post.slug === 'ielts-writing-task-types'
    ? <IeltsWritingTaskTypesBody />
    : post.slug === 'ielts-writing-opinion-analysis'
    ? <IeltsWritingOpinionAnalysisBody />
    : post.slug === 'ielts-writing-discussion-analysis'
    ? <IeltsWritingDiscussionAnalysisBody />
    : post.slug === 'ielts-writing-adv-disadv-analysis'
    ? <IeltsWritingAdvDisadvAnalysisBody />
    : post.slug === 'ielts-writing-problem-solution-analysis'
    ? <IeltsWritingProblemSolutionAnalysisBody />
    : post.slug === 'ielts-writing-two-part-question-analysis'
    ? <IeltsWritingTwoPartAnalysisBody />
    : post.slug === 'ielts-collocations'
    ? <IeltsCollocationsBody />
    : post.slug === 'ielts-writing-task1-line-graph'
    ? <IeltsTask1LineGraphBody />
    : post.slug === 'ielts-writing-task1-bar-chart'
    ? <IeltsTask1BarChartBody />
    : post.slug === 'ielts-writing-task1-pie-chart'
    ? <IeltsTask1PieChartBody />
    : post.slug === 'ielts-writing-task1-table'
    ? <IeltsTask1TableBody />
    : post.slug === 'ielts-writing-task1-mixed-chart'
    ? <IeltsTask1MixedChartBody />
    : post.slug === 'ielts-writing-task1-process'
    ? <IeltsTask1ProcessBody />
    : post.slug === 'ielts-writing-task1-map'
    ? <IeltsTask1MapBody />
    : post.slug === 'ielts-writing-task2-how-to'
    ? <IeltsWritingTask2HowToBody />
    : post.slug === 'ielts-writing-task2-structure-guide'
    ? <IeltsWritingTask2StructureGuideBody />
    : post.slug === 'same-question-two-worlds'
    ? <SameQuestionTwoWorldsBody />
    : <div class="prose"><Content /></div>
  }
</BaseLayout>
