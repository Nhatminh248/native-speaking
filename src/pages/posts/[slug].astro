---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import IeltsSpeakingBody from '../../components/posts/IeltsSpeakingBody.astro';
import IeltsWritingTaskTypesBody from '../../components/posts/IeltsWritingTaskTypesBody.astro';
import IeltsWritingOpinionAnalysisBody from '../../components/posts/IeltsWritingOpinionAnalysisBody.astro';
import IeltsWritingDiscussionAnalysisBody from '../../components/posts/IeltsWritingDiscussionAnalysisBody.astro';
import IeltsWritingAdvDisadvAnalysisBody from '../../components/posts/IeltsWritingAdvDisadvAnalysisBody.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <nav class="post-nav">
    <a href={import.meta.env.BASE_URL} class="post-nav-back">← All Posts</a>
  </nav>
  {post.slug === 'ielts-speaking'
    ? <IeltsSpeakingBody />
    : post.slug === 'ielts-writing-task-types'
    ? <IeltsWritingTaskTypesBody />
    : post.slug === 'ielts-writing-opinion-analysis'
    ? <IeltsWritingOpinionAnalysisBody />
    : post.slug === 'ielts-writing-discussion-analysis'
    ? <IeltsWritingDiscussionAnalysisBody />
    : post.slug === 'ielts-writing-adv-disadv-analysis'
    ? <IeltsWritingAdvDisadvAnalysisBody />
    : <div class="prose"><Content /></div>
  }
</BaseLayout>
